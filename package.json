{
  "name": "opencode-harness-kit",
  "version": "0.1.0",
  "description": "Model-agnostic harness kit for OpenCode: capability profiles, role-based reasoning effort, context pruning, and measured baselines.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./profile": "./src/profile.js",
    "./config": "./src/config.js",
    "./rules": "./src/rules.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "oc-harness": "./bin/oc-harness.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "profiles/",
    "examples/",
    "retention.yml",
    "GLOBAL.md",
    "agents/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "test:all": "npm run build && npm run typecheck && npm test",
    "test:install": "npm run measure:check && npm run attribute",
    "check": "npm run test:all && npm run test:install && node bin/oc-harness.mjs verify",
    "check:online": "npm run check && node bin/oc-harness.mjs doctor",
    "baseline": "node bin/baseline.mjs",
    "eval": "node eval/run.mjs",
    "measure": "node eval/measure-install.mjs",
    "measure:check": "node eval/measure-install.mjs --min-narrow 50 --min-ctx-drop 20",
    "attribute": "node eval/attribute.mjs",
    "attribute:json": "node eval/attribute.mjs --json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "harness",
    "context-management",
    "reasoning-effort"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}